---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/site';
import { twitterHandle } from '../utils/schema';
// Self-hosted fonts. These replace two preconnects and a render-blocking
// external stylesheet that previously sat on the critical path; Astro bundles
// and fingerprints the woff2 files instead. Family names are "Inter Variable"
// and "JetBrains Mono Variable" — see tailwind.config.mjs.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Text for a screen-reader-only <h1>. Pass this on pages whose visible
   * heading is a terminal prompt (`$ whoami`), which carries no keyword or
   * semantic content. Omit it on pages that already have a real visible h1 —
   * home, blog posts, 404 — so every page ends up with exactly one.
   */
  heading?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  heading,
  ogType = 'website',
  ogImage = siteConfig.ogImage,
  ogImageAlt = siteConfig.ogImageAlt,
  publishedTime,
  modifiedTime,
  noindex = false,
  schema,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.titleDefault;
const pageDescription = description || siteConfig.tagline;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Scrapers won't resolve relative image paths, so absolutize against the site.
const ogImageURL = new URL(ogImage, Astro.site);
// Only the generated default card is known to be 1200x630. A post supplying its
// own hero image can be any shape, and declaring dimensions we haven't measured
// is worse than declaring none — scrapers use them to reserve layout.
const isDefaultOgImage = ogImage === siteConfig.ogImage;
const twitter = twitterHandle();
const schemaBlocks = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={siteConfig.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />

    <!-- Icons (generated from assets/logo-portfolio.png by `npm run favicon`) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- OpenGraph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    {isDefaultOgImage && <meta property="og:image:width" content="1200" />}
    {isDefaultOgImage && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />

    {
      ogType === 'article' && (
        <>
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime.toISOString()} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime.toISOString()} />
          )}
          <meta property="article:author" content={siteConfig.author} />
        </>
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {twitter && <meta name="twitter:site" content={twitter} />}
    {twitter && <meta name="twitter:creator" content={twitter} />}

    <title>{pageTitle}</title>

    {
      schemaBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))
    }

    <!-- Prevent dark mode flash; flag JS for the reveal animation -->
    <script is:inline>
      document.documentElement.classList.add('js');
      const theme = localStorage.getItem('theme');
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else if (!theme) {
        // Default to dark
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-surface text-content min-h-screen flex flex-col font-sans antialiased">
    <Header />
    <main class="flex-1 max-w-3xl mx-auto w-full px-4 py-12">
      {heading && <h1 class="sr-only">{heading}</h1>}
      <slot />
    </main>
    <Footer />

    <script>
      const revealables = document.querySelectorAll('.reveal');

      if (!('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );

        revealables.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
