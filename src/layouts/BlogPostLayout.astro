---
import BaseLayout from './BaseLayout.astro';
import BlogPostMeta from '../components/BlogPostMeta.astro';
import { proseClasses } from '../styles/prose';
import { blogPostingSchema, breadcrumbSchema } from '../utils/schema';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  image?: string;
  imageAlt?: string;
}

const { title, description, pubDate, updatedDate, tags, image, imageAlt } = Astro.props;

const pathname = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={image}
  ogImageAlt={imageAlt || title}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  schema={[
    blogPostingSchema({ title, description, pubDate, updatedDate, tags, image }, pathname),
    breadcrumbSchema([
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: title, url: pathname },
    ]),
  ]}
>
  <article>
    <header class="mb-8 pb-6 border-b border-edge">
      <h1 class="font-mono text-2xl sm:text-3xl font-bold tracking-tight mb-4 leading-tight">
        {title}
      </h1>
      <BlogPostMeta pubDate={pubDate} tags={tags} />
      {
        updatedDate && (
          <p class="font-mono text-xs text-content-muted mt-2">
            Updated:{' '}
            {updatedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: '2-digit',
            })}
          </p>
        )
      }
    </header>

    {
      /*
       * `image` is a plain path from frontmatter, so its intrinsic dimensions
       * aren't known at build time and width/height attributes can't be set.
       * A fixed aspect-ratio reserves the space instead, which is what stops
       * the layout shift; object-cover crops to fit rather than distorting.
       */
      image && (
        <img
          src={image}
          alt={imageAlt || ''}
          class="rounded-md mb-8 w-full aspect-[1.91/1] object-cover bg-surface-raised"
          decoding="async"
        />
      )
    }

    <div class={proseClasses}>
      <slot />
    </div>

    <footer class="mt-12 pt-6 border-t border-edge">
      <a
        href="/blog"
        class="font-mono text-sm text-accent hover:text-accent-hover transition-colors"
      >
        &larr; back to blog
      </a>
    </footer>
  </article>
</BaseLayout>
